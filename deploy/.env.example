LIUGUANG_KB_PROJECT=liuguang-kb
LIUGUANG_KB_IMAGE=ghcr.io/zhang1003533565/liuguang-kb:latest
LIUGUANG_KB_NODE_IMAGE=node:24-alpine
LIUGUANG_KB_BASE_IMAGE=ghcr.io/1panel-dev/maxkb-base:python3.11-pg17.10-20260525
LIUGUANG_KB_POSTGRES_IMAGE=pgvector/pgvector:pg17
LIUGUANG_KB_REDIS_IMAGE=redis:7-alpine
LIUGUANG_KB_PORT=8080

POSTGRES_DB=liuguang_kb
POSTGRES_USER=liuguang_kb
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_MAX_CONNECTIONS=1000

REDIS_PASSWORD=change-me-redis

MAXKB_CONFIG=ENV
MAXKB_CONFIG_TYPE=ENV
MAXKB_VERSION=liuguang-kb-server
MAXKB_DEBUG=false
MAXKB_LOG_LEVEL=INFO
MAXKB_KNOWLEDGE_ONLY=true
MAXKB_SECRET_KEY=change-me-django-secret
MAXKB_DEFAULT_PASSWORD=LiuguangKB@123..
MAXKB_CORE_WORKER=2
MAXKB_DB_MAX_OVERFLOW=80
MAXKB_REDIS_DB=0
MAXKB_REDIS_MAX_CONNECTIONS=100
